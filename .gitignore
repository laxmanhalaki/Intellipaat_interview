# ==============================================================================
# Common .gitignore for Multi-Project Repo (Android + React Native)
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System & IDE Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# JetBrains / Android Studio / IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ------------------------------------------------------------------------------
# Android & Gradle (Common & intelli_android)
# ------------------------------------------------------------------------------
.gradle/
**/build/
build/
app/build/
captures/
.externalNativeBuild/
.cxx/
local.properties
*.hprof

# Android Keystores & Signing (keep secrets safe)
*.keystore
!debug.keystore
*.jks

# Kotlin
.kotlin/

# ------------------------------------------------------------------------------
# React Native & Node.js (intelli_react_native)
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Metro Bundler & Temporary Files
.metro-health-check*
*.jsbundle

# Test Coverage
coverage/
.nyc_output/

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ------------------------------------------------------------------------------
# iOS & Xcode (intelli_react_native/ios)
# ------------------------------------------------------------------------------
**/DerivedData/
DerivedData/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/
**/xcuserdata/
*.xccheckout
*.moved-aside
*.hmap
*.ipa
*.xcuserstate
**/.xcode.env.local

# CocoaPods & Ruby Bundler
**/Pods/
Pods/
.bundle/
**/vendor/bundle/
vendor/bundle/

# ------------------------------------------------------------------------------
# Fastlane
# ------------------------------------------------------------------------------
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots/
**/fastlane/test_output/

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
